{
  "name": "opencode-voice-dictation",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run test -- --coverage && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^20.10.6",
    "knip": "^6.24.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-monkey": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
